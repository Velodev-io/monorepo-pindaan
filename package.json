{
    "name": "pinddaan-monorepo",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:gangajal-web": "turbo run dev --filter=gangajal-web",
        "dev:gangajal-admin": "turbo run dev --filter=gangajal-admin",
        "dev:pinddaan-web": "turbo run dev --filter=pinddaan-web",
        "dev:pinddaan-admin": "turbo run dev --filter=pinddaan-admin",
        "dev:all": "turbo run dev",
        "lint": "turbo run lint"
    },
    "devDependencies": {
        "turbo": "latest"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "packageManager": "yarn@1.22.21"
}