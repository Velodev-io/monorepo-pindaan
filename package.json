{
    "name": "pinddaan-monorepo",
    "private": true,
    "scripts": {
        "build": "npx turbo run build",
        "dev": "npx turbo run dev",
        "dev:gangajal-web": "npx turbo run dev --filter=gangajal-web",
        "dev:gangajal-admin": "npx turbo run dev --filter=gangajal-admin",
        "dev:api": "npx turbo run dev --filter=api",
        "dev:gangajal": "npx turbo run dev --filter=gangajal-web --filter=gangajal-admin --filter=api",
        "dev:pinddaan-web": "npx turbo run dev --filter=pinddaan-web",
        "dev:pinddaan-admin": "npx turbo run dev --filter=pinddaan-admin",
        "dev:all": "npx turbo run dev",
        "lint": "npx turbo run lint"
    },
    "devDependencies": {
        "turbo": "latest"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "packageManager": "npm@11.11.0"
}