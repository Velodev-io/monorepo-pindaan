generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id // Maps to Firebase UID
  email         String   @unique
  name          String
  phone         String?
  address       String?
  role          UserRole @default(USER)
  isActive      Boolean  @default(true)
  bookings      Booking[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  PANDIT
}

model Service {
  id          String   @id @default(uuid())
  name        String
  basePrice   Float
  isActive    Boolean  @default(true)
  bookings    Booking[]
}

enum ServiceKey {
  ASTHI_VISARJAN
  PIND_DAAN
  SHRADDH
  TARPAN
}

model Location {
  id               String            @id @default(cuid())
  name             String
  state            String
  slug             String            @unique
  description      String?
  image            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  locationServices LocationService[]
  bookings         Booking[]
  pandits          Pandit[]
}

model LocationService {
  id         String     @id @default(cuid())
  locationId String
  location   Location   @relation(fields: [locationId], references: [id])
  service    ServiceKey
  isPrimary  Boolean    @default(false)
  notes      String?

  @@unique([locationId, service])
}

model Pandit {
  id         String   @id @default(uuid())
  name       String
  phone      String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  bookings   Booking[]
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  locationId    String
  location      Location      @relation(fields: [locationId], references: [id])
  panditId      String?
  pandit        Pandit?       @relation(fields: [panditId], references: [id])
  
  status        BookingStatus @default(PENDING)
  ritualDate    DateTime
  departedName  String
  gotra         String?
  address       String?
  cremationDate DateTime?
  fatherName    String?
  adminNotes    String?
  
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
