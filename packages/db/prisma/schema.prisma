generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id // Maps to Firebase UID
  email         String   @unique
  name          String
  phone         String?
  address       String?
  role          UserRole @default(USER)
  isActive      Boolean  @default(true)
  bookings      Booking[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  PANDIT
}

model Service {
  id          String   @id @default(uuid())
  name        String
  basePrice   Float
  isActive    Boolean  @default(true)
  bookings    Booking[]
}

enum ServiceKey {
  ASTHI_VISARJAN
  PIND_DAAN
  SHRADDH
  TARPAN
}

model Location {
  id               String            @id @default(cuid())
  name             String
  state            String
  slug             String            @unique
  description      String?
  image            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  locationServices LocationService[]
  bookings         Booking[]
  pandits          Pandit[]
}

model LocationService {
  id         String     @id @default(cuid())
  locationId String
  location   Location   @relation(fields: [locationId], references: [id])
  service    ServiceKey
  isPrimary  Boolean    @default(false)
  notes      String?

  @@unique([locationId, service])
}

model Pandit {
  id         String   @id @default(uuid())
  name       String
  phone      String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  bookings   Booking[]
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  locationId    String
  location      Location      @relation(fields: [locationId], references: [id])
  panditId      String?
  pandit        Pandit?       @relation(fields: [panditId], references: [id])
  
  status        BookingStatus @default(PENDING)
  ritualDate    DateTime
  departedName  String
  gotra         String?
  address       String?
  cremationDate DateTime?
  fatherName    String?
  adminNotes    String?
  
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  volumeMl    Int
  price       Float
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String        @id @default(uuid())
  userId          String?
  customerName    String
  customerEmail   String
  amount          Float
  currency        String        @default("USD")
  status          String        @default("PENDING") // Using String to avoid enum migration issues with Prisma/Postgres if not needed, mapped to OrderStatus enum in app
  paymentStatus   String        @default("PENDING")
  shippingAddress Json
  trackingNumber  String?
  carrier         String?
  adminNotes      String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  // product   Product @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  price     Float
}

model Review {
  id          String   @id @default(uuid())
  name        String
  email       String
  location    String?
  rating      Int
  text        String   @db.Text
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
